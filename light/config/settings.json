{
  "kdeglobals": {
    "General": {
      "ColorScheme": "PapirusBreezeLight",
      "AccentColor": "233,61,88",
      "LastUsedCustomAccentColor": "233,61,88",
      "font": "Noto Sans,10,-1,5,50,0,0,0,0,0"
    },
    "Icons": {
      "Theme": "PapirusBreezeLight"
    },
    "KDE": {
      "widgetStyle": "Breeze",
      "LookAndFeelPackage": "com.delta.papirus-breeze-light",
      "AnimationDurationFactor": "0.25",
      "contrast": "4",
      "frameContrast": "0.2"
    }
  },
  "kwinrc": {
    "org.kde.kdecoration2": {
      "library": "org.kde.kwin.aurorae.v2",
      "theme": "__aurorae__svg__Moe",
      "NoPlugin": "false",
      "BorderSizeAuto": "true",
      "ButtonsOnLeft": "M",
      "ButtonsOnRight": "IAX"
    },
    "TabBox": {
      "LayoutName": "org.kde.breeze.desktop"
    },
    "Plugins": {
      "kwin4_effect_shapecornersEnabled": "true",
      "papirus_inner_cornersEnabled": "true"
    },
    "Round-Corners": {
      "Size": "11",
      "InactiveCornerRadius": "11",
      "UseSquircleShape": "true",
      "Squircleness": "0.55",
      "UseNativeDecorationShadows": "true",
      "DisableRoundMaximize": "true",
      "DisableRoundFullScreen": "true",
      "DisableRoundTile": "false",
      "Exclusions": "dolphin,konsole",
      "OutlineThickness": "0",
      "InactiveOutlineThickness": "0",
      "SecondOutlineThickness": "0",
      "InactiveSecondOutlineThickness": "0",
      "OuterOutlineThickness": "0",
      "InactiveOuterOutlineThickness": "0"
    }
  },
  "plasmarc": {
    "Theme": {
      "name": "PapirusBreezeRed"
    }
  },
  "kcminputrc": {
    "Mouse": {
      "cursorTheme": "breeze_cursors",
      "cursorSize": "18"
    }
  },
  "auroraerc": {
    "Moe": {
      "ButtonSize": "0"
    }
  },
  "ksplashrc": {
    "KSplash": {
      "Engine": "KSplashQML",
      "Theme": "org.kde.breeze.desktop"
    }
  },
  "konsolerc": {
    "LightDarkTheme": {
      "SyncProfileWithSystemTheme": "true",
      "LightThemeProfile": "Papirus Breeze Light",
      "DarkThemeProfile": "Papirus Breeze Dark"
    },
    "Desktop Entry": {
      "DefaultProfile": "PapirusBreezeLight.profile"
    }
  }
}
