[kdeglobals][General]
ColorScheme=PapirusBreezeDark
AccentColor=233,61,88
LastUsedCustomAccentColor=233,61,88
font=Noto Sans,10,-1,5,50,0,0,0,0,0

[kdeglobals][Icons]
Theme=PapirusBreezeDark

[kdeglobals][KDE]
widgetStyle=Breeze
AnimationDurationFactor=0.25
contrast=4
frameContrast=0.2
DefaultDarkLookAndFeel=com.delta.papirus-breeze-dark

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__MoeDark
NoPlugin=false
BorderSizeAuto=true
ButtonsOnLeft=M
ButtonsOnRight=IAX

[kwinrc][Plugins]
kwin4_effect_shapecornersEnabled=true

[kwinrc][Round-Corners]
Size=11
InactiveCornerRadius=11
UseSquircleShape=true
Squircleness=0.55
UseNativeDecorationShadows=true
DisableRoundMaximize=true
DisableRoundFullScreen=true
DisableRoundTile=false
Exclusions=dolphin,konsole
OutlineThickness=0
InactiveOutlineThickness=0
SecondOutlineThickness=0
InactiveSecondOutlineThickness=0
OuterOutlineThickness=0
InactiveOuterOutlineThickness=0

[kwinrc][TabBox]
LayoutName=org.kde.breeze.desktop

[plasmarc][Theme]
name=PapirusBreezeRed

[kcminputrc][Mouse]
cursorTheme=Breeze_Light
cursorSize=18

[auroraerc][MoeDark]
ButtonSize=0

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=org.kde.breeze.desktop

[Wallpaper]
Image=MoeDark
